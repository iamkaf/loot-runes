{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "contact": {
    "sources": "https://github.com/iamkaf/loot-runes"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.iamkaf.lootrunes.LootRunesFabric"],
    "fabric-datagen": ["com.iamkaf.lootrunes.fabric.LootRunesDatagen"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "amber": "*",
    "minecraft": "${fabric_version_range}",
    "java": ">=${java_version}"
  }
}
